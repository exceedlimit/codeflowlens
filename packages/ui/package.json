{
  "name": "@codeflowlens/ui",
  "version": "0.1.0",
  "description": "CodeFlowLens 모니터링 UI 서버 — 트레이스/관계도/엔티티 시각화 (localhost)",
  "keywords": [
    "tracing",
    "monitoring",
    "call-graph",
    "visualization",
    "observability"
  ],
  "license": "Apache-2.0",
  "author": "exceedlimit",
  "homepage": "https://github.com/exceedlimit/codeflowlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exceedlimit/codeflowlens.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/exceedlimit/codeflowlens/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "codeflowlens-ui": "dist/server/cli.js",
    "cfl-ui": "dist/server/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xyflow/react": "^12.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
