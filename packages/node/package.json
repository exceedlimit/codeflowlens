{
  "name": "@codeflowlens/node",
  "version": "0.1.0",
  "description": "CodeFlowLens Node 추적기 — 코드 수정 0으로 함수 호출 흐름을 기록 (모듈 로드 시점 메모리 계측)",
  "keywords": [
    "tracing",
    "monitoring",
    "call-graph",
    "observability",
    "vite-plugin",
    "vibe-coding"
  ],
  "license": "Apache-2.0",
  "author": "exceedlimit",
  "homepage": "https://github.com/exceedlimit/codeflowlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exceedlimit/codeflowlens.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/exceedlimit/codeflowlens/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "codeflowlens": "dist/cli.js",
    "cfl": "dist/cli.js"
  },
  "exports": {
    "./register": "./dist/register.mjs",
    "./vite": {
      "types": "./dist/vite-plugin.d.mts",
      "default": "./dist/vite-plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.29.7",
    "better-sqlite3": "^12.0.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
